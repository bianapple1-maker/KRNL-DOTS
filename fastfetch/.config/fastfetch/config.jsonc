{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // KRNL • Misty Forest palette
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/krnl.txt",
    "padding": {
      "right": 3
    }
  },

  "display": {
    "separator": "  󰁔 ",
    "color": {
      "keys": "#B8B2A3",
      "title": "#D8D2C4"
    },
    "key": {
      "width": 12
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{##D8D2C4}krnl{##78858A}@{##B8B2A3}{host-name}"
    },
    {
      "type": "separator",
      "string": "────────────────────────────────"
    },
    {
      "type": "os",
      "key": "󰣇 OS"
    },
    {
      "type": "host",
      "key": "󰌢 Host"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },
    {
      "type": "de",
      "key": "󰧨 Desktop"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory"
    },
    {
      "type": "battery",
      "key": "󰁹 Battery"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
